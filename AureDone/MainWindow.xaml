<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AureDone"
        Width="1500"
        Height="900"
        WindowStyle="SingleBorderWindow">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="2"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#0f0f13"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#1a1a20"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#e8e8ed"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#a0a0a8"/>
        <SolidColorBrush x:Key="Border" Color="#33333d"/>
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26262f"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgPrimary}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top Bar -->
        <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,0">
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top"
                       Text="AUREDONE" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="20,10,0,10"/>
        </Border>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.Row="1"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">

            <DockPanel>

                

                <!-- Pinned to bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,8">
                    <Border Height="1" Background="{StaticResource Border}" Margin="4,0,4,8"/>
                    <Button Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="24" Height="24" Fill="#3d3d4a" VerticalAlignment="Center"/>
                            <TextBlock Text="username" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Scrollable nav -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="8,0,8,8">

                        <TextBlock Text="MENU" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="12,8,0,6"/>

                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <!-- <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="22" VerticalAlignment="Center"/> -->
                                
                                
                                <Path Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Data="M 8 2 V 6 M 16 2 V 6 M 3 10 H 21 M 5 4 H 19 A 2 2 0 0 1 21 6 V 20 A 2 2 0 0 1 19 22 H 5 A 2 2 0 0 1 3 20 V 6 A 2 2 0 0 1 5 4 Z"
                                      Fill="White"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="Today" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Upcoming" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource Border}" Margin="4,12"/>

                        <TextBlock Text="LISTS" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,6"/>
                        
                        <!-- Begin of lis-->
                        <!-- Entry in the List-->
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#7c7cf0" VerticalAlignment="Center"/>
                                <TextBlock Text="Work" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Entry in the List-->
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#5ec26a" VerticalAlignment="Center"/>
                                <TextBlock Text="Personal" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Entry in the List-->
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="Add List" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="{StaticResource BgPrimary}">

            <!-- Main content -->

        </Border>

        <!-- Right Panel -->
        <Border Grid.Column="2" Grid.Row="1"
                Background="{StaticResource BgPrimary}">

            <!-- Optional right panel -->

        </Border>

    </Grid>
</Window>
