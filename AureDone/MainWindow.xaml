<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AureDone"
        Width="1500"
        Height="900"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                       ResizeBorderThickness="6"
                       GlassFrameThickness="0"
                       CornerRadius="15"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#0f0f13"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#1a1a20"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#e8e8ed"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#a0a0a8"/>
        <SolidColorBrush x:Key="Border" Color="#33333d"/>
        
        <Style x:Key="SidebarHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style x:Key="SidebarEntryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style x:Key="SidebarSvg" TargetType="Path">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        
        <!-- Sidebar Button -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26262f"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CaptionButton must come earlier, since StaticResource only looks "up" not down -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26262f"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close button: same thing but hovers red -->
        <Style x:Key="CaptionButtonClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BgPrimary}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top Bar -->
        <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                >
            <DockPanel MinHeight="40">

                <!-- Logo + name -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            Margin="16,0,0,0" VerticalAlignment="Center">
                    
                    <!-- Application name -->
                    <TextBlock Text="AUREDONE" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="10,0,0,0"/>
                    
                </StackPanel>

                <!-- Window buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Name="BtnMinimize" Style="{StaticResource CaptionButton}"
                            ToolTip="Minimize" Click="Button_Action_Minimize">
                        <Path Data="M 0 5 H 10" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>

                    <Button Name="BtnMaximize" Style="{StaticResource CaptionButton}"
                            ToolTip="Maximize" Click="Button_Action_Maximize">
                        <Path Data="M 0.5 0.5 H 9.5 V 9.5 H 0.5 Z" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>

                    <Button Name="BtnClose" Style="{StaticResource CaptionButtonClose}"
                            ToolTip="Close" Click="Button_Action_Close">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.Row="1"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">

            <DockPanel>
                <!-- Pinned to bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,8">
                    <Border Height="1" Background="{StaticResource Border}" Margin="4,0,4,8"/>
                    <!-- <User-account> Username and Icon-->
                    <Button Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="24" Height="24" Fill="#3d3d4a" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource SidebarEntryText}" Text="Fabian_MCH" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource SidebarEntryText}" Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Scrollable nav -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="8,0,8,8">

                        <!-- <TextBlock Text="MENU" Style="{StaticResource SidebarHeaderText}"
                                   Foreground="{StaticResource TextSecondary}" Margin="12,8,0,6"/> -->
                        
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="5, 0, 5, 0">
                                <!-- Entry Icon - Dashboard -->
                                <Path Style="{StaticResource SidebarSvg}"
                                      Data="M317.23-308h32v-248h-32v248ZM464-308h32v-344h-32v344Zm146.77 0h32v-104h-32v104ZM240.62-184q-24.32 0-40.47-16.15T184-240.62v-478.76q0-24.32 16.15-40.47T240.62-776h478.76q24.32 0 40.47 16.15T776-719.38v478.76q0 24.32-16.15 40.47T719.38-184H240.62Zm0-32h478.76q9.24 0 16.93-7.69 7.69-7.69 7.69-16.93v-478.76q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H240.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v478.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69ZM216-744v528-528Z"/>
                                
                                <TextBlock Style="{StaticResource SidebarEntryText}" Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="5, 0, 5, 0">
                                <!-- Entry Icon - Files -->
                                <Path Style="{StaticResource SidebarSvg}"
                                      Data="M192.62-232q-23.62 0-40.12-16.5Q136-265 136-288.62v-382.76q0-24.32 16.5-40.47T192.62-728h175.23l96 96h303.53q24.32 0 40.47 16.15T824-575.38v286.76q0 23.62-16.15 40.12Q791.7-232 767.38-232H192.62Zm0-32h574.76q10.77 0 17.7-6.92 6.92-6.93 6.92-17.7v-286.76q0-10.77-6.92-17.7-6.93-6.92-17.7-6.92H450.77l-96-96H192.62q-10.77 0-17.7 6.92-6.92 6.93-6.92 17.7v382.76q0 10.77 6.92 17.7 6.93 6.92 17.7 6.92ZM168-264v-432 432Z"
                                      />
                                
                                <TextBlock Style="{StaticResource SidebarEntryText}" Text="Files" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="5, 0, 5, 0">
                                <!-- Entry Icon - Material -->
                                <Path Style="{StaticResource SidebarSvg}"
                                      Data="M669.85-320.46q0 76.78-52.69 130.62T488.46-136q-77.92 0-130.42-56.27-52.5-56.27-52.5-135.19v-368.23q0-53.46 36.65-90.89Q378.85-824 432.31-824q54.46 0 90.61 39.92 36.16 39.93 36.16 95.39v345.77q0 29.37-20.62 50.76-20.62 21.39-50 21.39-30.23 0-51.19-22.17-20.96-22.16-20.96-53.98v-342.31h32v346.31q0 16.55 11.41 28.35 11.42 11.8 27.97 11.8 16.56 0 27.97-11.8 11.42-11.8 11.42-28.35v-353.54q.77-39.62-27.2-67.58Q471.92-792 432.11-792q-39.81 0-67.19 29.35-27.38 29.34-27.38 68.96v373.23q.77 63.08 44.31 107.27Q425.38-169 488.46-168t107-45.69q43.92-46.69 42.39-111.77v-363.77h32v368.77Z"
                                      />
                                
                                <TextBlock Style="{StaticResource SidebarEntryText}" Text="Material" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="5, 0, 5, 0">
                                <!-- Entry Icon - Calendar -->
                                <Path Style="{StaticResource SidebarSvg}"
                                      Data="M240.62-136q-24.32 0-40.47-16.5T184-192.62v-478.76q0-23.62 16.15-40.12Q216.3-728 240.62-728h102.76v-105.23h35.08V-728h206.16v-105.23h32V-728h102.76q24.32 0 40.47 16.5T776-671.38v478.76q0 23.62-16.15 40.12Q743.7-136 719.38-136H240.62Zm0-32h478.76q9.24 0 16.93-7.69 7.69-7.69 7.69-16.93v-310.76H216v310.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69ZM216-535.39h528v-135.99q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H240.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v135.99Zm0 0V-696v160.61Z"
                                      />
                                
                                <TextBlock Style="{StaticResource SidebarEntryText}" Text="Calendar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        

                        <Border Height="1" Background="{StaticResource Border}" Margin="4,12"/>

                        <TextBlock Style="{StaticResource SidebarHeaderText}" Text="Recent Files"
                                   Foreground="{StaticResource TextSecondary}" Margin="12,0,0,6"/>
                        
                        <!-- Begin of Recent Files list -->
                        <!-- Entry in the List-->
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="5, 0, 5, 0">
                                <!-- Entry Icon - Homework.docx -->
                                <Path Style="{StaticResource SidebarSvg}"
                                      Data="M312.62-136q-27.62 0-42.12-14.5Q256-165 256-192.62v-574.76q0-27.62 14.5-42.12Q285-824 312.62-824h178.06q10.55 0 21.24 3.85 10.7 3.84 19.39 13.3l156.31 160.93q8.69 8.69 12.53 18.5 3.85 9.81 3.85 20.96v413.84q0 27.62-14.5 42.12Q675-136 647.38-136H312.62ZM452-792H312.62q-10.77 0-17.7 7.31-6.92 7.31-6.92 17.31v574.76q0 10.77 6.92 17.7 6.93 6.92 17.7 6.92h334.76q10 0 17.31-6.92 7.31-6.93 7.31-17.7v-396.46H533.08q-33.46 0-57.27-24.57Q452-638.23 452-673.23V-792Zm32 6v113.25q0 20.67 13.81 36.17t35.27 15.5H642v-24.61L507.08-786H484Zm-81.85 512.92q-6.83 0-11.42-4.52-4.58-4.52-4.58-11.27t4.58-11.48q4.59-4.73 11.42-4.73H492q6.84 0 11.42 4.52t4.58 11.27q0 6.75-4.58 11.48T492-273.08h-89.85Zm0-135.54q-6.83 0-11.42-4.52-4.58-4.52-4.58-11.26 0-6.75 4.58-11.48 4.59-4.74 11.42-4.74h154.93q6.84 0 11.42 4.52 4.58 4.53 4.58 11.27 0 6.75-4.58 11.48t-11.42 4.73H402.15Z"
                                />
                                <TextBlock Text="Homework.docx" VerticalAlignment="Center" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Entry in the List-->
                        <Button Style="{StaticResource NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="5, 0, 5, 0">
                                <!-- Entry Icon - Dashboard -->
                                <Path Style="{StaticResource SidebarSvg}"
                                      Data="M317.23-308h32v-248h-32v248ZM464-308h32v-344h-32v344Zm146.77 0h32v-104h-32v104ZM240.62-184q-24.32 0-40.47-16.15T184-240.62v-478.76q0-24.32 16.15-40.47T240.62-776h478.76q24.32 0 40.47 16.15T776-719.38v478.76q0 24.32-16.15 40.47T719.38-184H240.62Zm0-32h478.76q9.24 0 16.93-7.69 7.69-7.69 7.69-16.93v-478.76q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H240.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v478.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69ZM216-744v528-528Z"/>

                                <TextBlock Text="Q3.xlsx" VerticalAlignment="Center" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Button>
                        
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="{StaticResource BgPrimary}">

            <!-- Main content -->

        </Border>

        <!-- Right Panel -->
        <Border Grid.Column="2" Grid.Row="1"
                Background="{StaticResource BgPrimary}">

            <!-- Optional right panel -->

        </Border>

    </Grid>
</Window>
